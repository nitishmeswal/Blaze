# Copy to .env.local for local dev:
#   cp .env.example .env.local
# Both variables are server-only and never shipped to the browser bundle.

# --- LLM brain (Phase 1+) -----------------------------------------
# Required for the `groq` provider to be picked by /api/generate.
# Get a key from https://console.groq.com/keys (free tier OK).
GROQ_API_KEY=

# --- Deploy button (Phase 4) --------------------------------------
# Required for the "Deploy to Vercel" target in /api/deploy.
# Without it the API returns HTTP 503 and the UI falls back to the
# zip-download path. Create a token at https://vercel.com/account/tokens.
# Scope: Full Account (or scoped to your team).
VERCEL_API_TOKEN=

# Optional. If your Vercel account uses teams and you want deploys to
# go under a specific team rather than your personal account, set this
# to the team ID (looks like `team_xxxxxxxx`).
# VERCEL_TEAM_ID=
